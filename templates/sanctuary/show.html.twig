{% extends 'base.html.twig' %}

{% block title %}{{ article.title }} | L'EMPREINTE{% endblock %}

{% block body %}
<main class="max-w-[1440px] mx-auto px-[150px] pt-32 pb-32 min-h-screen">
    <article class="max-w-3xl mx-auto">
        <header class="mb-16">
            <p class="text-[10px] uppercase tracking-[0.4em] text-zen-forest font-medium mb-4">Le Sanctuaire</p>
            <h1 class="text-6xl font-cormorant italic text-zen-ink leading-tight">{{ article.title }}</h1>
            <div class="h-[0.5px] w-48 bg-zen-forest/20 mt-8"></div>
        </header>

        <div class="font-eb-garamond text-xl text-zen-ink/80 leading-relaxed text-justify first-letter:text-7xl first-letter:font-cormorant first-letter:italic first-letter:text-zen-forest first-letter:mr-3 first-letter:float-left">
            {{ content|raw }}
        </div>
    </article>
</main>
{% endblock %}
{% extends 'base.html.twig' %}

{% block body %}
<main class="bg-zen-sand min-h-screen pt-32 pb-32 px-6">
    <article class="max-w-[800px] mx-auto">
        <header class="mb-16 text-center">
            <span class="text-[10px] uppercase tracking-[0.4em] text-zen-forest font-bold">{{ article.category }}</span>
            <h1 class="text-6xl font-cormorant italic text-zen-ink mt-4">{{ article.title }}</h1>
        </header>

        <div class="font-eb-garamond text-xl text-zen-ink/80 leading-relaxed text-justify 
                    first-letter:text-7xl first-letter:font-cormorant first-letter:italic 
                    first-letter:text-zen-forest first-letter:mr-3 first-letter:float-left">
            {{ content|raw }}
        </div>
    </article>
</main>
{% endblock %}
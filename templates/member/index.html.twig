{% extends 'base.html.twig' %}

{% block title %}Mon Espace | L'EMPREINTE{% endblock %}

{% block body %}
<main class="max-w-[1440px] mx-auto px-[150px] pt-32 pb-32 min-h-screen font-eb-garamond">
    
    <header class="mb-20">
        <h1 class="text-6xl font-cormorant italic text-zen-ink mb-4">Bonjour, {{ user.firstName }}</h1>
        <p class="text-zen-ink/50 uppercase tracking-[0.3em] text-xs">Votre chemin de soin et d'équilibre</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-start">
        
        {# --- SECTION 1 : VOS SÉANCES --- #}
        <section class="space-y-12">
            <h2 class="text-2xl font-cormorant italic border-b border-zen-ink/5 pb-4">Vos rendez-vous</h2>
            <div class="space-y-6">
                {% for rdv in appointments %}
                    <div class="flex justify-between items-center p-6 bg-white/10 border border-zen-ink/5 rounded-sm">
                        <div>
                            <div class="text-zen-forest font-bold">{{ rdv.dateTime|date('d.m.Y à H:i') }}</div>
                            <div class="text-sm italic text-zen-ink/70">{{ rdv.treatment.title }}</div>
                        </div>
                        <div class="text-[10px] uppercase tracking-widest text-zen-ink/40 italic">{{ rdv.status|lower }}</div>
                    </div>
                {% else %}
                    <p class="italic text-zen-ink/30 text-sm">Aucune séance planifiée.</p>
                {% endfor %}
            </div>
        </section>

        {# --- SECTION 2 : L'HISTORIQUE DU DIALOGUE (Synchronicité) --- #}
        <section class="space-y-12">
            <h2 class="text-2xl font-cormorant italic border-b border-zen-ink/5 pb-4">Historique de vos échanges</h2>
            <div class="space-y-10">
                {% for exchange in exchanges %}
                    <div class="space-y-4">
                        {# Votre message #}
                        <div class="p-6 bg-white/30 border-l-2 border-zen-forest/20 rounded-sm ml-4">
                            <div class="flex justify-between text-[9px] uppercase tracking-widest text-zen-ink/40 mb-3">
                                <span>Votre message • {{ exchange.createdAt|date('d.m.Y') }}</span>
                            </div>
                            <p class="text-sm italic leading-relaxed">" {{ exchange.message }} "</p>
                        </div>

                        {# La réponse de Sandrine (si elle existe) #}
                        {% if exchange.practitionerResponse %}
                            <div class="p-6 bg-zen-forest/5 border-l-2 border-zen-forest rounded-sm mr-4">
                                <div class="text-[9px] uppercase tracking-widest text-zen-forest font-bold mb-3 italic">
                                    L'écho de Sandrine
                                </div>
                                <p class="text-sm leading-relaxed text-zen-ink/80">{{ exchange.practitionerResponse }}</p>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <p class="italic text-zen-ink/30 text-sm text-center py-10 border border-dotted border-zen-ink/10">
                        Le fil de votre histoire n'a pas encore commencé ici.
                    </p>
                {% endfor %}
            </div>
        </section>

    </div>
</main>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}L'Empreinte - L'équilibre par le Shiatsu{% endblock %}

{% block body %}
<main class="min-h-screen flex flex-col items-center justify-center p-6 text-center">
    
    {# Section Titre (Inspiration Frame 01) #}
    <div class="max-w-4xl space-y-8 mb-20">
        <h1 class="text-6xl md:text-8xl font-serif italic leading-[1.1]">
            L'équilibre <br>
            <span class="text-[#8A9A5B]">par le Shiatsu</span>
        </h1>
        
        <p class="font-eb-garamond text-xl text-zen-ink/80 leading-relaxed italic">
            Retrouvez l’harmonie entre le corps et l’esprit. <br>
            Une approche thérapeutique subtile pour libérer vos tensions <br>
            et restaurer votre vitalité profonde.
        </p>

        <div class="flex gap-4 justify-center">
            {# Correction du lien : on utilise la route app_soins_public créée hier #}
       <a href="{{ path('app_soins_public') }}" 
       class="inline-block bg-zen-ink text-zen-sand px-10 py-3 rounded-full uppercase tracking-[0.4em] text-[9px] font-bold hover:bg-zen-forest transition-all shadow-sm">
       Découvrir les soins
       </a>
        </div>
    </div>

    {# Section Nos Protocoles - Version Chirurgicale #}
    <section style="width: 100%; padding: 100px 0; border-top: 1px solid rgba(45,41,38,0.1);">
    <h2 style="font-family: serif; font-style: italic; text-align: center; margin-bottom: 100px; color: #2D2926; font-size: 2.5rem;">Nos Protocoles de soin</h2>

    <div style="max-width: 1100px; margin: 0 auto; padding: 0 40px;">
        {% for treatment in treatments %}
            <article style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 120px; gap: 80px; flex-direction: {{ loop.index is even ? 'row-reverse' : 'row' }};">
                
                {# BLOC IMAGE : Propre, sans bandes, avec ombre portée #}
                <div style="width: 50%; flex-shrink: 0;">
                    {# L'ombre est ici renforcée avec une opacité de 0.15 sur la couleur zen-ink #}
                    <div style="aspect-ratio: 4/3; border-radius: 30px; overflow: hidden; box-shadow: 0 20px 40px rgba(45, 41, 38, 0.15); background-color: white;">
                        {% if treatment.imagePath %}
                            <img src="{{ asset('images/treatments/' ~ treatment.imagePath) }}" 
                                 alt="{{ treatment.title }}" 
                                 style="width: 100%; height: 100%; object-fit: cover; display: block; border: none;">
                        {% endif %}
                    </div>
                </div>

                {# BLOC TEXTE : Aligné et élégant #}
                <div style="width: 50%; text-align: left;">
                    <h3 style="font-size: 2.2rem; font-family: serif; font-style: italic; margin-bottom: 20px; color: #2D2926; line-height: 1.2;">
                        {{ treatment.title }}
                    </h3>
                    
                    <p style="font-family: 'EB Garamond', serif; font-size: 1.2rem; font-style: italic; color: #2D2926; opacity: 0.7; line-height: 1.7; margin-bottom: 25px;">
                        {{ treatment.protocolBenefits|default('Retrouvez un équilibre profond grâce à ce soin traditionnel ciblé.') }}
                    </p>

                    <div style="font-size: 0.75rem; letter-spacing: 0.3em; font-weight: bold; color: rgba(45,41,38,0.5); text-transform: uppercase; margin-bottom: 30px;">
                        {{ treatment.duration }} MIN &nbsp;&nbsp; — &nbsp;&nbsp; {{ treatment.price }} €
                    </div>

                    <a href="{{ path('app_soins_public') }}" 
                       style="display: inline-block; border-bottom: 2px solid #8A9A5B; text-decoration: none; color: #2D2926; font-size: 0.65rem; letter-spacing: 0.4em; font-weight: bold; text-transform: uppercase; padding-bottom: 5px;">
                        S'offrir ce soin
                    </a>
                </div>

            </article>
        {% endfor %}
    </div>
</section>
</main>
{% endblock %}
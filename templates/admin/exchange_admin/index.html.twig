{% extends 'base.html.twig' %}
{% block title %}Messages reçus | Admin{% endblock %}
{% block body %}
<main class="max-w-[1440px] mx-auto px-[150px] pt-12 pb-32">
    <h1 class="text-4xl font-cormorant italic text-zen-ink mb-12">Échanges Thérapeutiques</h1>
    <div class="bg-white/30 backdrop-blur-sm border border-zen-ink/5">
        <table class="w-full font-eb-garamond text-sm text-left">
            <thead>
                <tr class="border-b border-zen-ink/10 text-[10px] uppercase tracking-widest text-zen-ink/40">
                    <th class="px-6 py-4">Date</th>
                    <th class="px-6 py-4">Patient</th>
                    <th class="px-6 py-4">Sujet</th>
                    <th class="px-6 py-4">Statut</th>
                    <th class="px-6 py-4 text-right">Action</th>
                </tr>
            </thead>
            <tbody>
                {% for echange in echanges %}
                <tr class="border-b border-zen-ink/5">
                    <td class="px-6 py-4">{{ echange.createdAt|date('d/m/Y') }}</td>
                    <td class="px-6 py-4">{{ echange.patient.firstName }} {{ echange.patient.lastName }}</td>
                    <td class="px-6 py-4 italic">"{{ echange.subject }}"</td>
                    <td class="px-6 py-4">
                        <span class="px-2 py-1 {{ echange.status == 'TRAITÉ' ? 'bg-zen-forest/20 text-zen-forest' : 'bg-zen-sand text-zen-ink' }} text-[10px] font-bold">
                            {{ echange.status }}
                        </span>
                    </td>
                    <td class="px-6 py-4 text-right">
                        <a href="{{ path('app_admin_exchange_show', {id: echange.id}) }}" class="underline decoration-zen-forest/20 font-bold">Répondre</a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
{% extends 'base.html.twig' %}
{% block title %}Lecture de l'échange | Admin{% endblock %}
{% block body %}
<main class="max-w-[1440px] mx-auto px-[150px] pt-20 pb-32">
    <header class="mb-16">
        <a href="{{ path('app_admin_exchange_index') }}" class="text-xs uppercase tracking-widest text-zen-ink/50 hover:text-zen-forest italic">← Retour aux échanges</a>
        <h1 class="text-5xl font-cormorant italic text-zen-ink mt-8">Échange avec {{ echange.patient.firstName }} {{ echange.patient.lastName }}</h1>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-20">
        <div class="bg-white/30 p-10 border border-zen-ink/5">
            <p class="text-[10px] uppercase tracking-widest text-zen-ink/40 mb-4 italic">Message du patient • {{ echange.createdAt|date('d/m/Y') }}</p>
            <h3 class="text-xl font-cormorant mb-4 text-zen-ink italic">Sujet : {{ echange.subject }}</h3>
            <p class="font-eb-garamond text-lg text-zen-ink leading-relaxed">"{{ echange.message }}"</p>
        </div>

        <div class="bg-zen-sand/50 p-10 border border-zen-forest/20">
            <h3 class="font-cormorant italic text-2xl text-zen-forest mb-6">Votre Réponse Thérapeutique</h3>
            <form method="post">
                <textarea name="reply" rows="6" class="w-full bg-white/50 border-none p-6 font-eb-garamond text-lg focus:ring-1 focus:ring-zen-forest outline-none mb-6" placeholder="Partagez vos conseils ici...">{{ echange.practitionerResponse }}</textarea>
                <button type="submit" class="bg-zen-forest text-white px-8 py-4 text-[10px] uppercase tracking-widest font-bold hover:bg-zen-ink transition-colors">Transmettre la réponse</button>
            </form>
        </div>
    </div>
</main>
{% endblock %}
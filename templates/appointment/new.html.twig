{% extends 'base.html.twig' %}
{% block title %}Réserver un instant | L'EMPREINTE{% endblock %}
{% block body %}
<main class="max-w-[1440px] mx-auto px-[150px] pt-32 pb-32 min-h-screen font-eb-garamond">
    <div class="flex flex-col md:flex-row gap-24 items-start">
        {# BLOC 1 : L'Intention (Gauche) #}
        <div class="md:w-1/3 space-y-12">
            <header>
                <h1 class="text-6xl font-cormorant italic text-zen-ink leading-tight mb-4">
                    <span class="text-zen-forest text-7xl">R</span>éserver un instant
                </h1>
                <div class="h-[0.5px] w-full bg-zen-forest/30"></div>
            </header>
            <div class="space-y-6">
                <p class="text-xl italic text-zen-ink/60">Définir l'intention de votre soin</p>
                {{ form_start(form, {'attr': {'class': 'space-y-10'}}) }}
                    <div class="space-y-2">
                        {{ form_widget(form.treatment, {'attr': {'class': 'w-full bg-transparent border-b border-zen-ink/10 py-3 font-eb-garamond text-lg outline-none focus:border-zen-forest appearance-none'}}) }}
                    </div>
                    <div class="pt-12 space-y-4">
                        <p class="text-[10px] uppercase tracking-[0.3em] text-zen-ink/40 font-medium">L'Ancrage horaire</p>
                        {{ form_widget(form.date_time, {'attr': {'class': 'w-full bg-transparent border-b border-zen-ink/10 py-3 font-eb-garamond text-lg outline-none'}}) }}
                    </div>
                    <div class="pt-16">
                        <button type="submit" class="bg-zen-forest text-zen-sand px-12 py-4 uppercase text-[10px] tracking-[0.3em] rounded-full hover:bg-zen-ink transition-all shadow-md">
                            Confirmer mon engagement
                        </button>
                    </div>
                {{ form_end(form) }}
            </div>
        </div>
        {# BLOC 2 : L'Horizon Temporel (Droite) #}
        <div class="md:w-2/3 bg-white/40 backdrop-blur-md p-12 rounded-sm border border-zen-ink/5 shadow-xl flex justify-center sticky top-32">
            <div class="text-center space-y-8">
                <p class="font-cormorant italic text-3xl text-zen-ink">Sélectionner une date</p>
                <div class="p-8 border border-dotted border-zen-forest/20 rounded-full w-72 h-72 flex items-center justify-center mx-auto bg-zen-sand/20 italic text-zen-forest text-[10px] tracking-widest uppercase">
                    Utilisez le champ <br> à gauche pour <br> valider l'heure
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}